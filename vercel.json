{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/vender",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/afinar",
      "destination": "/caso",
      "permanent": true
    },
    {
      "source": "/comprar",
      "destination": "/compradores",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    }
  ]
}
